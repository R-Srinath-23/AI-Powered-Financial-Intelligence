# Gemini API Key (Required for AI categorization and Financial Analyst chat)
GEMINI_API_KEY=your_gemini_api_key_here

# Django Secret Key (Optional - a default is provided for development)
SECRET_KEY=django-insecure-your-secret-key-here

# Django Debug mode (True for local dev, False for production)
DEBUG=False

# FastAPI Backend URL (Defaults to http://127.0.0.1:8000 when running together)
FASTAPI_URL=http://127.0.0.1:8000
